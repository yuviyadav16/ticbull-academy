{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "batches.html",
      "use": "@vercel/static"
    },
    {
      "src": "payment.html",
      "use": "@vercel/static"
    },
    {
      "src": "chat.html",
      "use": "@vercel/static"
    },
    {
      "src": "logo.png",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/app.py"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/batches.html",
      "destination": "/batches.html"
    },
    {
      "source": "/payment.html",
      "destination": "/payment.html"
    },
    {
      "source": "/chat.html",
      "destination": "/chat.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
