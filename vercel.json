{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "batches.html",
      "use": "@vercel/static"
    },
    {
      "src": "classroom.html",
      "use": "@vercel/static"
    },
    {
      "src": "payment.html",
      "use": "@vercel/static"
    },
    {
      "src": "chat.html",
      "use": "@vercel/static"
    },
    {
      "src": "practice.html",
      "use": "@vercel/static"
    },
    {
      "src": "pyqs.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "animation.mp4",
      "use": "@vercel/static"
    },
    {
      "src": "privacy-policy.html",
      "use": "@vercel/static"
    },
    {
      "src": "terms.html",
      "use": "@vercel/static"
    },
    {
      "src": "refund-policy.html",
      "use": "@vercel/static"
    },
    {
      "src": "contact.html",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/app.py"
    },
    {
      "source": "/dashboard.html",
      "destination": "/dashboard.html"
    },
    {
      "source": "/batches.html",
      "destination": "/batches.html"
    },
    {
      "source": "/classroom.html",
      "destination": "/classroom.html"
    },
    {
      "source": "/payment.html",
      "destination": "/payment.html"
    },
    {
      "source": "/chat.html",
      "destination": "/chat.html"
    },
    {
      "source": "/practice.html",
      "destination": "/practice.html"
    },
    {
      "source": "/pyqs.html",
      "destination": "/pyqs.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/animation.mp4",
      "destination": "/animation.mp4"
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms.html",
      "destination": "/terms.html"
    },
    {
      "source": "/refund-policy.html",
      "destination": "/refund-policy.html"
    },
    {
      "source": "/contact.html",
      "destination": "/contact.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
